--- !u!114 &5198421846402412849
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8007107460138960205}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eec4e43df63d63a4685e6a22d151717f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  content: "Kapitel 8\nNew York\nFreitag, 13. Dezember 2022\n\n\n\nVerdammt. Ich
    hatte verschlafen. Wie hatte das passieren k\xF6nnen? Ich musste den Wecker einfach
    weggedr\xFCckt haben, ohne es zu merken. Das grelle Leuchten meines Handydisplays
    blendete mich: 10:45 Uhr. In einer Viertelstunde sollte ich bereits im Natural
    History Museum sein f\xFCr meine erste grosse live Moderation und das schien
    kaum machbar. Die Subwayfahrt von Dumbo bis zum Museum w\xFCrde mindestens dreissig
    Minuten in Anspruch nehmen. Panik durchstr\xF6mte mich, w\xE4hrend ich eilig
    auf meinem Smartphone tippte und Keith benachrichtigte:\n\nShit! Habe verschlafen.
    Ich beeile mich, es sollte mir auf 11:45 Uhr reichen. Sorry!\n\nHoffentlich w\xFCrde
    diese Nachricht ausreichen, um die Situation zu retten. Immerhin begann die Livesendung
    erst um vierzehn Uhr und wir hatten nicht mehr allzu viel vorzubereiten.\n\nEine
    Nachricht von Keith ploppte auf: \n\nKeine Sorge, Bill und ich haben alles im
    Griff! Bis gleich.\n\nJetzt aber los, dachte ich mir. Ich \xFCberlegte, wie ich
    am schnellsten zum National History Museum gelangte. Mit einem Taxi w\xE4re ich
    bestimmt schneller als mit der U-Bahn."
  leftSide: {fileID: 8540251058166378552}
  rightSide: {fileID: 61940947685857190}
  leftPagination: {fileID: 8343112355405219230}
  rightPagination: {fileID: 9145345326914757059}
